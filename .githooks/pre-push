#!/usr/bin/env bash
# Install: ./scripts/install-hooks.sh  (sets core.hooksPath=.githooks)
# Refuses the push on actionlint, gitleaks, denylist, unpinned uses, or
# companion-repo names in public docs. Missing tools fail the push (never open).
# Pushing refs/tags/v* also requires guardrails + test CI both "success" on that
# commit (gh run list); missing/unauthenticated gh fails closed.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Capture push refs before any child can consume stdin.
push_refs="$(cat)"

if ! command -v actionlint >/dev/null 2>&1; then
  echo "actionlint is required for pre-push (brew install actionlint)" >&2
  exit 2
fi
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is required for pre-push (brew install gitleaks)" >&2
  exit 2
fi
if ! command -v grep >/dev/null 2>&1; then
  echo "grep is required for pre-push denylist check" >&2
  exit 2
fi

denylist="$root/scripts/check-internal-identifiers.sh"
pins="$root/scripts/check-action-pins.sh"
docs="$root/scripts/check-public-docs.sh"
for script in "$denylist" "$pins" "$docs"; do
  if [[ ! -f "$script" ]]; then
    echo "missing guardrail script: $script" >&2
    exit 2
  fi
  if [[ ! -x "$script" ]]; then
    echo "guardrail script not executable: $script" >&2
    exit 2
  fi
done

actionlint </dev/null
gitleaks protect --staged --verbose --no-banner </dev/null
gitleaks detect --source . --log-opts='--all' --verbose --no-banner </dev/null
"$denylist" </dev/null
"$pins" </dev/null
"$docs" </dev/null

# --- v* tag gate: both CI workflows must be green on the tagged commit ---
zero="$(printf '0%.0s' {1..40})"
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "${local_ref:-}" ]] || continue
  case "$local_ref" in
    refs/tags/v*)
      if [[ "$local_sha" == "$zero" ]]; then
        continue # tag delete
      fi
      tag="${local_ref#refs/tags/}"
      if ! command -v gh >/dev/null 2>&1; then
        echo "error: gh is required to push ${tag} (fail closed)" >&2
        exit 2
      fi
      if ! gh auth status >/dev/null 2>&1; then
        echo "error: gh must be authenticated to push ${tag} (fail closed)" >&2
        exit 2
      fi
      runs_json="$(gh run list --commit "$local_sha" --json name,conclusion --limit 50)" || {
        echo "error: gh run list failed for ${local_sha} (fail closed)" >&2
        exit 2
      }
      if ! printf '%s' "$runs_json" | python3 -c '
import json, sys
runs = json.load(sys.stdin)
# Latest run per workflow name (gh lists newest first).
latest = {}
for r in runs:
    name = r.get("name") or ""
    if name and name not in latest:
        latest[name] = r.get("conclusion") or ""
need = ("guardrails", "test")
missing = [n for n in need if latest.get(n) != "success"]
if missing:
    print("latest conclusions:", latest, file=sys.stderr)
    print("refusing: need success for:", ", ".join(missing), file=sys.stderr)
    sys.exit(1)
'; then
        echo "error: refusing push of ${tag} (${local_sha}): guardrails and test must both be success" >&2
        exit 1
      fi
      echo "ok: ${tag} → ${local_sha}: guardrails + test success"
      ;;
  esac
done <<<"$push_refs"
