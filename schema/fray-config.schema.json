{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fray:fray-config:v1",
  "title": "fray.yaml",
  "description": "Human augmentation of a plan. Declared elements, flows, and boundary membership, plus annotations on inferred elements, on flow data class, and to fill an authz_scope the parser omitted. Addresses are a Terraform address, declared:<key>, or signal:<type>:<name>.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "fray-config/v1"
    },
    "redaction": {
      "const": "off",
      "description": "Client-side only. Omit (default) to redact identifying fields before POST. Explicit off sends plaintext names and addresses; the hosted API rejects unredacted payloads unless the org allows it."
    },
    "audit_config": {
      "const": "owned_by_this_root",
      "description": "Only affects missing audit evidence. When set, absent S3 logging/CloudTrail coverage, GCP Secret Manager DATA_READ config, or GCS DATA_READ config is reported as off (open). When omitted, missing evidence leaves audit_logging unset (unverified). Logging or audit configs present in the plan always count as covered regardless of this setting."
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "annotations": {
      "$ref": "#/$defs/annotations"
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "allOf": [
        {
          "not": {
            "pattern": "://"
          }
        },
        {
          "not": {
            "pattern": "="
          }
        }
      ]
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "type",
        "kind"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/address"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "enum": [
            "process",
            "datastore",
            "external_entity"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "$ref": "#/$defs/purpose"
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "data_class",
        "transport"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/address"
        },
        "to": {
          "$ref": "#/$defs/address"
        },
        "data_class": {
          "enum": [
            "credentials",
            "customer_data",
            "logs",
            "config",
            "unknown"
          ]
        },
        "transport": {
          "enum": [
            "tls",
            "plaintext",
            "local",
            "unknown"
          ]
        },
        "authz_scope": {
          "enum": [
            "resource",
            "project",
            "account",
            "organization",
            "public"
          ]
        },
        "authz_grants": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "resource",
              "project",
              "account",
              "organization",
              "public"
            ]
          }
        },
        "secret_delivery": {
          "enum": [
            "env",
            "volume"
          ]
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "inside",
        "outside"
      ],
      "properties": {
        "kind": {
          "enum": [
            "network",
            "account",
            "provider",
            "operator"
          ]
        },
        "inside": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "outside": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/address"
          }
        }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element_annotation"
          }
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flow_annotation"
          }
        }
      }
    },
    "element_annotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signal": {
          "$ref": "#/$defs/address"
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "$ref": "#/$defs/purpose"
        }
      },
      "anyOf": [
        {
          "required": [
            "signal"
          ],
          "anyOf": [
            {
              "required": [
                "kind"
              ]
            },
            {
              "required": [
                "provider"
              ]
            },
            {
              "required": [
                "purpose"
              ]
            }
          ]
        },
        {
          "required": [
            "address",
            "purpose"
          ]
        }
      ]
    },
    "flow_annotation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Patches one parser-emitted flow. data_class rewrites the class. authz_scope fills a scope the parser omitted and requires reason. A derived scope, or a match count other than one, is ignored with a warning.",
      "properties": {
        "from": {
          "$ref": "#/$defs/address"
        },
        "to": {
          "$ref": "#/$defs/address"
        },
        "data_class": {
          "enum": [
            "credentials",
            "customer_data",
            "logs",
            "config",
            "unknown"
          ]
        },
        "authz_scope": {
          "description": "Fill an omitted authz_scope. Must match the parser flow when data_class is also set.",
          "enum": [
            "resource",
            "project",
            "account",
            "organization"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 10,
          "description": "Why this scope is known. Required when authz_scope is set. Stays in the repository."
        }
      },
      "required": [
        "from",
        "to"
      ],
      "anyOf": [
        {
          "required": [
            "data_class"
          ]
        },
        {
          "required": [
            "authz_scope",
            "reason"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "authz_scope"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "purpose": {
      "enum": [
        "audit_archive",
        "customer_uploads",
        "backups",
        "static_assets",
        "logs",
        "secrets",
        "app_data",
        "internal_api",
        "public_api",
        "other"
      ]
    }
  }
}
