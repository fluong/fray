{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fray:mitigation:v1",
  "title": "Fray mitigations",
  "description": "DEPRECATED — use .fray/waivers.yml (schema/waivers.schema.json). Legacy customer overlay. An entry accepts one engine finding. Non-empty mitigations.yaml is rejected by Action v0.7.0+; migrate entries to waivers (add id/owner/expires, drop status: accepted).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "const": "mitigation/v1" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "address", "status", "reason"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^FR-[0-9]{3}$" },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "allOf": [
            { "not": { "pattern": "://" } },
            { "not": { "pattern": "=" } }
          ]
        },
        "status": { "const": "accepted" },
        "reason": { "type": "string", "minLength": 1 },
        "revisit": { "type": "string", "minLength": 1 }
      }
    }
  }
}
