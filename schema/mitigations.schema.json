{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fray:mitigation:v1",
  "title": "Fray mitigations",
  "description": "Customer overlay, kept in the customer repo. An entry accepts one engine finding. The key is rule_id plus a human-readable address. The client translates the address to an element or flow id before the graph or the findings leave CI. Accepted never gates CI. The engine does not emit accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "const": "mitigation/v1" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "address", "status", "reason"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^FR-[0-9]{3}$" },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "allOf": [
            { "not": { "pattern": "://" } },
            { "not": { "pattern": "=" } }
          ]
        },
        "status": { "const": "accepted" },
        "reason": { "type": "string", "minLength": 1 },
        "revisit": { "type": "string", "minLength": 1 }
      }
    }
  }
}
