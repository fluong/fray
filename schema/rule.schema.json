{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fray:rule:v1",
  "title": "Fray rule",
  "description": "A rule selects elements or flows, then checks a pass condition. when and pass are conjunctions at the top level: every condition must hold. Nested any (disjunction) and all (conjunction) combine child conditions via conds. Operators are equals, in, exists, not, any, all, lte, gte, and contains. A when condition that reads an absent attribute does not match, so the rule emits nothing. Once when matches, pass true is mitigated and pass false is open. equals, in, lte, and gte yield unverified when the attribute is absent; not of an unverified read is unverified. any is true if any child is true, else unverified if any child is unverified, else false. all is false if any child is false, else unverified if any child is unverified, else true. exists is true or false, including when the attribute is absent. A false condition wins over an unverified sibling. Unverified does not gate CI. boundary equals kind/direction and matches one crossing of the flow. The evaluator rejects a field that does not apply to target.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "threat", "explanation", "stride", "severity", "platforms", "target", "when", "pass", "rationale", "mitigation", "evaluation"],
  "properties": {
    "id": { "type": "string", "pattern": "^FR-([0-9]{3}|[A-Z][A-Z0-9]{1,9}-[0-9]{4})$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "threat": { "type": "string", "minLength": 1, "maxLength": 160 },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 400 },
    "group": { "type": "string", "minLength": 1, "maxLength": 160 },
    "group_title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "before": { "type": "string", "minLength": 1, "maxLength": 400 },
    "remediations": {
      "type": "array",
      "items": { "$ref": "#/$defs/remediation" }
    },
    "stride": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stride" }
    },
    "severity": { "enum": ["low", "medium", "high"] },
    "severity_by_boundary": {
      "type": "object",
      "additionalProperties": false,
      "description": "When a flow crosses a boundary of this kind, the finding severity is the higher of the rule severity and this override.",
      "properties": {
        "network": { "enum": ["low", "medium", "high"] },
        "account": { "enum": ["low", "medium", "high"] },
        "provider": { "enum": ["low", "medium", "high"] },
        "operator": { "enum": ["low", "medium", "high"] }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["aws", "gcp", "azure", "cloudflare", "kubernetes"] },
      "description": "Parsers that emit the element kinds this rule reads."
    },
    "category": {
      "enum": ["exposure", "encryption", "identity", "logging", "resilience", "supply_chain", "data_flow"]
    },
    "introduced": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date (YYYY-MM-DD) the rule first shipped on the hosted service. Omit for rules in the first public release. Version gating is min_action, not this field."
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation",
      "description": "Plain-language outcomes for the public rule catalog."
    },
    "target": { "enum": ["element", "flow"] },
    "when": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/condition" }
    },
    "pass": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/condition" }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "mitigation": { "type": "string", "minLength": 1 },
    "why_here": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "description": "Optional rule-authored context for an open finding when context_when matches. Takes precedence over LLM enrichment. Never labeled AI."
    },
    "fix_here": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "description": "Optional rule-authored fix that replaces the generic mitigation line when context_when matches."
    },
    "context_when": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/condition" },
      "description": "When every condition holds on the finding's target, emit why_here/fix_here."
    },
    "covers": {
      "type": "object",
      "additionalProperties": false,
      "description": "DFD attributes this rule already speaks for. Used by restates_rule matching.",
      "properties": {
        "attributes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["attributes"]
    },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" }
    }
  },
  "$defs": {
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open", "mitigated", "unverified"],
      "properties": {
        "open": { "type": "string", "minLength": 1, "maxLength": 400 },
        "mitigated": { "type": "string", "minLength": 1, "maxLength": 400 },
        "unverified": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "stride": {
      "enum": [
        "spoofing",
        "tampering",
        "repudiation",
        "information_disclosure",
        "denial_of_service",
        "elevation_of_privilege"
      ]
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "resource", "text"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 400 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "id"],
      "properties": {
        "framework": { "type": "string", "minLength": 1, "maxLength": 64 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": { "enum": ["equals", "in", "exists", "not", "any", "all", "lte", "gte", "contains"] },
        "field": { "$ref": "#/$defs/field" },
        "value": {
          "anyOf": [
            { "type": "string" },
            { "type": "boolean" },
            { "type": "number" },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "anyOf": [
                  { "type": "string" },
                  { "type": "boolean" },
                  { "type": "number" }
                ]
              }
            }
          ]
        },
        "cond": { "$ref": "#/$defs/condition" },
        "conds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "op": { "const": "not" } },
            "required": ["op"]
          },
          "then": {
            "required": ["cond"],
            "not": { "anyOf": [{ "required": ["field"] }, { "required": ["value"] }, { "required": ["conds"] }] }
          }
        },
        {
          "if": {
            "properties": { "op": { "enum": ["any", "all"] } },
            "required": ["op"]
          },
          "then": {
            "required": ["conds"],
            "not": { "anyOf": [{ "required": ["field"] }, { "required": ["value"] }, { "required": ["cond"] }] }
          }
        },
        {
          "if": {
            "properties": { "op": { "const": "exists" } },
            "required": ["op"]
          },
          "then": {
            "required": ["field"],
            "not": { "anyOf": [{ "required": ["value"] }, { "required": ["cond"] }, { "required": ["conds"] }] }
          }
        },
        {
          "if": {
            "properties": { "op": { "const": "contains" } },
            "required": ["op"]
          },
          "then": {
            "required": ["field", "value"],
            "not": { "anyOf": [{ "required": ["cond"] }, { "required": ["conds"] }] },
            "properties": { "value": { "not": { "type": "array" } } }
          }
        },
        {
          "if": {
            "properties": { "op": { "enum": ["equals", "in", "lte", "gte"] } },
            "required": ["op"]
          },
          "then": {
            "required": ["field", "value"],
            "not": { "anyOf": [{ "required": ["cond"] }, { "required": ["conds"] }] }
          }
        },
        {
          "if": {
            "properties": { "op": { "const": "equals" } },
            "required": ["op"]
          },
          "then": {
            "properties": { "value": { "not": { "type": "array" } } }
          }
        },
        {
          "if": {
            "properties": { "op": { "const": "in" } },
            "required": ["op"]
          },
          "then": {
            "properties": { "value": { "type": "array" } }
          }
        },
        {
          "if": {
            "properties": { "op": { "enum": ["lte", "gte"] } },
            "required": ["op"]
          },
          "then": {
            "properties": { "value": { "type": "number" } }
          }
        },
        {
          "if": {
            "properties": { "field": { "const": "boundary" }, "op": { "const": "equals" } },
            "required": ["field", "op"]
          },
          "then": {
            "properties": { "value": { "$ref": "#/$defs/boundary" } }
          }
        },
        {
          "if": {
            "properties": { "field": { "const": "boundary" }, "op": { "const": "in" } },
            "required": ["field", "op"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "items": { "$ref": "#/$defs/boundary" }
              }
            }
          }
        }
      ]
    },
    "boundary": {
      "enum": [
        "network/outside_to_inside",
        "network/inside_to_outside",
        "account/outside_to_inside",
        "account/inside_to_outside",
        "provider/outside_to_inside",
        "provider/inside_to_outside",
        "operator/outside_to_inside",
        "operator/inside_to_outside"
      ]
    },
    "field": {
      "enum": [
        "type",
        "kind",
        "provider",
        "subtype",
        "provider_subtype",
        "provenance",
        "purpose",
        "attributes.public",
        "attributes.public_ip",
        "attributes.acls_disabled",
        "attributes.admin_ports_open",
        "attributes.public_access_blocked",
        "attributes.encrypted_at_rest",
        "attributes.deletion_protection",
        "attributes.region",
        "attributes.max_instances",
        "attributes.image_pinned_by_digest",
        "attributes.audit_logging",
        "attributes.rotation_configured",
        "attributes.versioning",
        "attributes.object_lock",
        "attributes.network_restricted",
        "attributes.tls_enforced",
        "data_class",
        "transport",
        "authz_scope",
        "authz_grants",
        "secret_delivery",
        "from.type",
        "from.kind",
        "from.provider",
        "from.purpose",
        "to.type",
        "to.kind",
        "to.provider",
        "to.purpose",
        "to.attributes.object_lock",
        "to.attributes.versioning",
        "to.attributes.public_access_blocked",
        "to.attributes.acls_disabled",
        "boundary",
        "internet_reachable",
        "inbound_writer"
      ]
    }
  }
}
